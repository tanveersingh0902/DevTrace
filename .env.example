# PostgreSQL (used by Docker Compose and local development)
POSTGRES_USER=devtrace
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=devtrace
POSTGRES_PORT=5432

# Backend
APP_ENV=development
APP_NAME=DevTrace API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://devtrace:change-me-for-local-development@localhost:5432/devtrace
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Frontend
VITE_API_BASE_URL=http://localhost:8000
