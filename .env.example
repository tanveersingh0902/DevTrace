# Local PostgreSQL settings. Create the role and databases separately.
POSTGRES_USER=devtrace
POSTGRES_PASSWORD=YOUR_LOCAL_PASSWORD
POSTGRES_DB=devtrace
POSTGRES_PORT=5432

# Backend (root .env). URL-encode the password in DATABASE_URL.
APP_ENV=development
APP_NAME=DevTrace API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://devtrace:YOUR_ENCODED_PASSWORD@localhost:5432/devtrace
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=3600

# Set in the pytest shell. Use a dedicated local database ending in _test.
# TEST_DATABASE_URL=postgresql+psycopg://devtrace:YOUR_ENCODED_PASSWORD@localhost:5432/devtrace_test

# Vite reads frontend/.env.local or the frontend process environment.
# To override its default, put the following setting there:
# VITE_API_BASE_URL=http://localhost:8000
