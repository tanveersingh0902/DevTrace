# Locally installed PostgreSQL (no Docker required)
POSTGRES_USER=devtrace
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=devtrace
POSTGRES_PORT=5432

# Backend
APP_ENV=development
APP_NAME=DevTrace API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://devtrace:change-me-for-local-development@localhost:5432/devtrace
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=3600
# Tests use a separate local database ending in _test. Set this in your shell:
# TEST_DATABASE_URL=postgresql+psycopg://devtrace:your-password@localhost:5432/devtrace_test

# Frontend
VITE_API_BASE_URL=http://localhost:8000
